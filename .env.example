# ── Malnad Realty PRIME — environment configuration ──────────────────────────
# Copy this file to `.env.local` and fill in the real values.

# WhatsApp number in international format, digits only (country code + number).
# Example: 919999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# ── Live inventory (Google Sheets) ──────────────────────────────────────────
# All fetched SERVER-SIDE only, so nothing here reaches the browser.
#
# Option A — a Google Apps Script Web App URL that returns plot JSON.
INVENTORY_SHEET_URL=

# Option B — a PUBLIC ("anyone with the link can view") Google Sheet.
# Just the Sheet ID (and the tab's gid). Read via the gviz endpoint, no key.
INVENTORY_SHEET_ID=16Nptjh38y40iFyz8lkU4LTQsRglveW4VQHM8xGez3xs
INVENTORY_SHEET_GID=0

# Option C — a PRIVATE sheet via the Sheets API (server-side only).
# Provide a Google API key restricted to your server + a cell range.
GOOGLE_SHEETS_API_KEY=
INVENTORY_SHEET_RANGE=A1:K

# How long (seconds) to cache inventory before revalidating.
INVENTORY_REVALIDATE_SECONDS=120

# ── Analytics (optional) ─────────────────────────────────────────────────────
# Google Analytics 4 measurement id (e.g. G-XXXXXXXXXX). Leave blank to disable.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Public site URL (used for canonical + JSON-LD).
NEXT_PUBLIC_SITE_URL=https://prime.malnadrealty.com
